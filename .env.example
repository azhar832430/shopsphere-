# ==============================================================================
# SHOPSPHERE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' in the project root to configure your environment.
# IMPORTANT: Never commit the actual '.env' file with production credentials.
# Standard XAMPP default: leave DB_PASS empty and DB_USER as root.
# ==============================================================================

# Application Environment: 'production' or 'development'
APP_NAME="ShopSphere"
APP_ENV=production
APP_URL=http://localhost/ShopSphere

# Database Connection (MySQL 8.0+ / MariaDB 10.4+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shopsphere_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session Security & Lifetime (seconds: 7200 = 2 hours)
SESSION_LIFETIME=7200

# Error Display Policy (0 = disabled in production, 1 = enabled for debugging)
DISPLAY_ERRORS=0

