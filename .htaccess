# ==============================================================================
# SHOPSPHERE - PRODUCTION APACHE WEB SERVER CONFIGURATION (.htaccess)
# ==============================================================================

# Set Default Document
DirectoryIndex index.html

# Disable Directory Browsing / File Indexing
Options -Indexes

# ------------------------------------------------------------------------------
# 1. Protect Sensitive Files Against Direct HTTP Access
# ------------------------------------------------------------------------------
<FilesMatch "(^\.env|\.git|\.sql|\.log|\.bak|\.swp|\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 2. Restrict Direct Web Access to Internal Code & Schema Directories
# ------------------------------------------------------------------------------
RedirectMatch 403 ^/.*(config|database|tests)/.*$

# ------------------------------------------------------------------------------
# 3. Security HTTP Response Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Prevent clickjacking / framing
    Header set X-Frame-Options "SAMEORIGIN"

    # Enable legacy XSS filter in browsers
    Header set X-XSS-Protection "1; mode=block"

    # Referrer policy for external links
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ------------------------------------------------------------------------------
# 4. Enforce Character Encoding
# ------------------------------------------------------------------------------
AddDefaultCharset UTF-8

